class Solution {
    public String countAndSay(int n) {

        String s = "1";
        int i = 1;

        while (i < n) {
            String result = "";
            int j = 0;

            while (j < s.length()) {
                char ch = s.charAt(j);
                int count = 0;

                while (j < s.length() && s.charAt(j) == ch) {
                    count++;
                    j++;
                }

                result = result + count + ch;
            }

            s = result;
            i++;
        }

        return s;
    }
}
